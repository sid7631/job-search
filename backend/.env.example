# AI Job Hunter — environment configuration.
# Copy to `.env` and fill in. No secrets in code or the database.

# --- LLM (ranking + resume parsing) ---
GEMINI_API_KEY=
LLM_MODEL=gemini-1.5-flash

# --- Telegram notifier ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# How many top picks to push, and the minimum score counted as a "high-quality" match.
TELEGRAM_TOP_N=10
TELEGRAM_MIN_SCORE=0

# --- Naukri collector ---
NAUKRI_EMAIL=
NAUKRI_PASSWORD=
NAUKRI_KEYWORDS=python backend engineer
NAUKRI_LOCATION=bangalore
NAUKRI_EXPERIENCE=5

# --- LinkedIn collector (fragile + against ToS; see README. Conservative by default) ---
LINKEDIN_EMAIL=
LINKEDIN_PASSWORD=
LINKEDIN_KEYWORDS=backend engineer
LINKEDIN_LOCATION=India
LINKEDIN_MAX_PAGES=3
LINKEDIN_DELAY_MULTIPLIER=1.75

# --- Collector behaviour (shared by all Playwright collectors) ---
COLLECTOR_MAX_PAGES=5
# Naukri 403-blocks headless browsers; run headed (needs a desktop/display).
COLLECTOR_HEADLESS=false
COLLECTOR_MIN_DELAY_SECONDS=1.5
COLLECTOR_MAX_DELAY_SECONDS=4.0
COLLECTOR_MAX_RETRIES=3
STORAGE_STATE_DIR=./.playwright

# --- Normalizer / deduplication ---
# rapidfuzz token_sort_ratio above this (0-100) merges two jobs as the same role.
DEDUPE_FUZZY_THRESHOLD=90

# --- LLM ranking ---
# Max concurrent Gemini calls for cache misses (the SDK has no batch endpoint).
RANKING_MAX_CONCURRENCY=4

# --- API ---
# Comma-separated allowed CORS origins (the React dev server).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Database (SQLite by default; swap DB_URL for Postgres later) ---
DB_URL=sqlite:///./job_hunter.db

# --- Scheduler ---
RUN_HOUR=8
TIMEZONE=Asia/Kolkata
