# AI Job Hunter — environment configuration.
# Copy to `.env` and fill in. No secrets in code or the database.

# --- LLM (ranking + resume parsing) ---
# Provider: openai | anthropic | ollama | ollama_cloud | groq | deepseek | mistral
#           | openrouter | together | xai | lmstudio | openai_compatible
LLM_PROVIDER=ollama
# API key for the chosen provider. Not needed for `ollama` / `lmstudio` (local).
LLM_API_KEY=
# Model name. Falls back to the provider's default when blank
# (ollama -> llama3.2, ollama_cloud -> gpt-oss:120b, openai -> gpt-4o-mini, ...).
LLM_MODEL=
# Base URL. Falls back to the provider's default when blank; required for
# `openai_compatible`. Ollama local -> http://localhost:11434/v1,
# Ollama Cloud -> https://ollama.com/v1
LLM_BASE_URL=

# --- Telegram notifier ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# How many top picks to push, and the minimum score counted as a "high-quality" match.
TELEGRAM_TOP_N=10
TELEGRAM_MIN_SCORE=0
# Push only roles first seen in this run, so an unactioned job is not re-sent nightly.
TELEGRAM_ONLY_NEW=true

# --- Naukri collector ---
NAUKRI_EMAIL=
NAUKRI_PASSWORD=
# Leave blank to derive from your parsed resume (desired roles / location / years).
# Anything you set here — or on the Settings page — wins over the resume.
NAUKRI_KEYWORDS=
NAUKRI_LOCATION=
NAUKRI_EXPERIENCE=
# The public results page carries per-job URLs and needs no login. Logging in
# switches to a UI with no per-card URL and invites an OTP/captcha challenge.
NAUKRI_REQUIRE_LOGIN=false

# --- LinkedIn collector (fragile + against ToS; see README. Conservative by default) ---
LINKEDIN_EMAIL=
LINKEDIN_PASSWORD=
# Blank = derived from your resume, same as the Naukri fields above.
LINKEDIN_KEYWORDS=
LINKEDIN_LOCATION=
LINKEDIN_MAX_PAGES=3
LINKEDIN_DELAY_MULTIPLIER=1.75
# LinkedIn pushes an "is this you?" prompt to your phone on login. The run waits
# this long for you to approve it before skipping the source. 0 = fail immediately.
LINKEDIN_APPROVAL_WAIT_SECONDS=180

# --- Collector behaviour (shared by all Playwright collectors) ---
COLLECTOR_MAX_PAGES=5
# Naukri 403-blocks headless browsers; run headed (needs a desktop/display).
COLLECTOR_HEADLESS=false
COLLECTOR_MIN_DELAY_SECONDS=1.5
COLLECTOR_MAX_DELAY_SECONDS=4.0
COLLECTOR_MAX_RETRIES=3
STORAGE_STATE_DIR=./.playwright

# --- Normalizer / deduplication ---
# rapidfuzz token_sort_ratio above this (0-100) merges two jobs as the same role.
DEDUPE_FUZZY_THRESHOLD=90

# --- LLM ranking ---
# Max concurrent LLM calls for cache misses.
RANKING_MAX_CONCURRENCY=4

# --- Pre-filter (cheap + deterministic; runs before any LLM call) ---
# Max jobs sent to the LLM per run. 0 = no cap (rank everything).
PREFILTER_MAX_JOBS=50
# Drop jobs whose cheap relevance score is below this (0-100). 0 = keep everything.
PREFILTER_MIN_SCORE=0

# --- Detail enrichment (open the real posting before ranking) ---
# Search cards carry almost no text; this fetches the real description so the LLM has
# something to judge. Costs one page load per job, so it is capped.
ENRICH_ENABLED=true
ENRICH_MAX_JOBS=30

# --- Feedback loop ---
# Feed your tracked APPLIED / DROPPED decisions into the ranking prompt.
FEEDBACK_ENABLED=true
FEEDBACK_MAX_EXAMPLES=8

# --- API ---
# Comma-separated allowed CORS origins (the React dev server).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Database (SQLite by default; swap DB_URL for Postgres later) ---
DB_URL=sqlite:///./job_hunter.db

# --- Scheduler ---
RUN_HOUR=8
TIMEZONE=Asia/Kolkata
