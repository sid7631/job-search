#!/usr/bin/env bash
# One command to set up and run Job Hunter.
#
#   ./jobhunter           set up anything missing, then open the app (one process, :8000)
#   ./jobhunter dev       API + Vite hot reload on :5173, for working on the frontend
#   ./jobhunter run       run the pipeline once in this terminal (scrape + score)
#   ./jobhunter mcp       print the Claude Desktop config for the MCP server
#
# Safe to re-run: every setup step is skipped when it is already done.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BACKEND="$ROOT/backend"
FRONTEND="$ROOT/frontend"
PORT="${PORT:-8000}"

say()  { printf '\033[1;32m▲\033[0m %s\n' "$*"; }
fail() { printf '\033[1;31m✗\033[0m %s\n' "$*" >&2; exit 1; }

need() {
  command -v "$1" >/dev/null 2>&1 || fail "$1 is not installed. $2"
}

setup() {
  need uv "Install it with: curl -LsSf https://astral.sh/uv/install.sh | sh"
  need npm "Install Node.js 20+ from https://nodejs.org (or: brew install node)"

  if [ ! -f "$BACKEND/.env" ]; then
    cp "$BACKEND/.env.example" "$BACKEND/.env"
    say "Created backend/.env from the template (everything can be set from the app)."
  fi

  say "Python dependencies"
  (cd "$BACKEND" && uv sync --quiet)

  # The scrapers drive a real Chromium; installing it is a one-time ~150 MB download.
  if ! ls "$HOME/Library/Caches/ms-playwright" 2>/dev/null | grep -q '^chromium' \
     && ! ls "$HOME/.cache/ms-playwright" 2>/dev/null | grep -q '^chromium'; then
    say "Installing the browser the scrapers use (one time)"
    (cd "$BACKEND" && uv run playwright install chromium)
  fi

  say "Database"
  (cd "$BACKEND" && uv run alembic upgrade head >/dev/null 2>&1) \
    || (cd "$BACKEND" && uv run alembic upgrade head)

  if [ ! -d "$FRONTEND/node_modules" ]; then
    say "Frontend dependencies (one time)"
    (cd "$FRONTEND" && npm install --silent)
  fi
}

build_frontend() {
  local dist="$FRONTEND/dist/index.html"
  if [ ! -f "$dist" ] || [ -n "$(find "$FRONTEND/src" "$FRONTEND/index.html" -newer "$dist" -print -quit)" ]; then
    say "Building the dashboard"
    (cd "$FRONTEND" && npm run build --silent >/dev/null)
  fi
}

port_free() {
  if lsof -nP -iTCP:"$PORT" -sTCP:LISTEN >/dev/null 2>&1; then
    fail "Port $PORT is already in use — Job Hunter may already be running (http://localhost:$PORT). Use PORT=8001 ./jobhunter to pick another."
  fi
}

open_when_ready() {
  local url="$1"
  for _ in $(seq 1 60); do
    if curl -fsS "http://127.0.0.1:$PORT/api/runs/current" >/dev/null 2>&1; then
      say "Job Hunter is running at $url  (Ctrl+C to stop)"
      [ -z "${NO_OPEN:-}" ] && command -v open >/dev/null && open "$url" || true
      return
    fi
    sleep 0.5
  done
}

case "${1:-start}" in
  start)
    port_free
    setup
    build_frontend
    open_when_ready "http://localhost:$PORT" &
    cd "$BACKEND" && exec uv run python -m app.main serve-api --host 127.0.0.1 --port "$PORT"
    ;;
  dev)
    port_free
    setup
    (cd "$BACKEND" && uv run python -m app.main serve-api --host 127.0.0.1 --port "$PORT" --reload) &
    API_PID=$!
    trap 'kill $API_PID 2>/dev/null' EXIT
    cd "$FRONTEND" && npm run dev
    ;;
  run)
    setup
    cd "$BACKEND" && exec uv run python -m app.main run-pipeline
    ;;
  mcp)
    cat <<JSON
Add this to Claude Desktop → Settings → Developer → Edit config
(~/Library/Application Support/Claude/claude_desktop_config.json):

{
  "mcpServers": {
    "job-hunter": {
      "command": "$(command -v uv || echo uv)",
      "args": ["--directory", "$BACKEND", "run", "python", "-m", "app.mcp_server"]
    }
  }
}

Claude Code picks it up automatically from .mcp.json when opened in this folder.
JSON
    ;;
  help|-h|--help)
    sed -n '2,9p' "$0" | sed 's/^# \{0,1\}//'
    ;;
  *)
    sed -n '2,9p' "$0" | sed 's/^# \{0,1\}//'
    exit 1
    ;;
esac
